# Secrets — generated per install, never committed
.env
*.env
!*.env.example

# Dependencies and build output
node_modules/
.next/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Build output only at known places — a bare `build/` would hide the
# app's agents/build page.
/dist/
/build/
apps/*/dist/
coverage/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
